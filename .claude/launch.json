{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@armorix/api", "dev"],
      "port": 3350
    },
    {
      "name": "api-r2",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@armorix/api", "exec", "tsx", "--conditions=development", "--env-file-if-exists=../../.env.local", "--env-file=../../.local/r2.env", "src/dev.ts"],
      "port": 3350
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@armorix/web", "exec", "node", "--env-file=.env", "node_modules/@react-router/dev/bin.js", "dev", "--port", "3354", "--strictPort"],
      "port": 3354
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@armorix/admin", "dev"],
      "port": 3351
    }
  ]
}
