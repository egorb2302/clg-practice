# Server loaders call ${API_ORIGIN}/api/v1/... ; the browser calls relative /api/v1/... and /admin/... (both proxied)
API_ORIGIN=http://localhost:3350
# 1 = local fixtures with the same shapes as the API (no backend needed); ignored in production unless ALLOW_MOCK=1
API_MOCK=
# Absolute site origin for canonical and Open Graph URLs
SITE_ORIGIN=https://armorix.ru
# Shared with the API (SITE_PROXY_SECRET there): lets the API trust the visitor IP the site forwards
SITE_PROXY_SECRET=
