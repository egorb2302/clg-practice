    "typecheck": "react-router typegen && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@armorix/contracts": "workspace:*",
    "@react-router/node": "7.18.5",
    "@react-router/serve": "7.18.5",
    "@vercel/react-router": "1.3.7",
    "isbot": "5.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
